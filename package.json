{
  "name": "micwizard",
  "productName": "MicWizard",
  "version": "0.1.2",
  "description": "Discover networked wireless mic receivers, monitor Dante/AES67 audio levels and battery status, and route USB soundcard inputs for non-Dante devices.",
  "private": true,
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "node --experimental-strip-types --test test/**/*.test.mts",
    "lint": "eslint src"
  },
  "dependencies": {
    "bonjour-service": "^1.4.4",
    "pino": "^10.3.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "electron": "^43.2.0",
    "electron-vite": "^5.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^5.5.4",
    "vite": "^6.4.3"
  },
  "allowScripts": {
    "electron@32.3.3": true,
    "esbuild@0.21.5": true,
    "fsevents@2.3.3": true
  }
}
